<resources>
    <!-- Base application theme (AppCompat - no XML Material3 needed for Compose) -->
    <style name="Theme.CamOBS" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_sys_color_primary</item>
        <item name="colorPrimaryVariant">@color/md_sys_color_primary_container</item>
        <item name="colorOnPrimary">@color/md_sys_color_on_primary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_sys_color_secondary</item>
        <item name="colorSecondaryVariant">@color/md_sys_color_secondary_container</item>
        <item name="colorOnSecondary">@color/md_sys_color_on_secondary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/md_sys_color_background</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.CamOBS.Splash" parent="Theme.CamOBS">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>