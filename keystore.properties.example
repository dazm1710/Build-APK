# ==========================================
# CamOBS - Configuración de Signing (Release)
# ==========================================
# COPIA este archivo a keystore.properties y rellena los valores
# NO SUBAS keystore.properties A GITHUB (está en .gitignore)

# Keystore
signingStoreFile=../keystore/release.keystore
signingStorePassword=TU_STORE_PASSWORD
signingKeyAlias=camobs-release
signingKeyPassword=TU_KEY_PASSWORD

# Para GitHub Actions: configura estos secrets en Settings > Secrets > Actions:
# SIGNING_STORE_FILE (base64 del .keystore)
# SIGNING_STORE_PASSWORD
# SIGNING_KEY_ALIAS
# SIGNING_KEY_PASSWORD